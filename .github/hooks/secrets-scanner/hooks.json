
{
  "hooks": {
    "stop": [
      {
        "type": "command",
        "command": "./.github/hooks/secrets-scanner/scan-secrets.sh",
        "cwd": ".",
        "env": {
          "SCAN_MODE": "block",
          "SCAN_SCOPE": "diff",
          "SECRETS_LOG_DIR": "./logs/copilot/secrets/"
        },
        "timeout": 30
      }
    ]
  }
}
